#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, set = 0, binding = 0) uniform writeonly image3D out_aerial_lut;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image3D out_aerial_optical_depth_lut;
layout(set = 0, binding = 2) uniform sampler2D transmittanceLut;

layout(push_constant) uniform AtmosphereAerialPush
{
    vec4 planet_center_radius;
    vec4 atmosphere_params;
    vec4 beta_rayleigh;
    vec4 beta_mie;
    vec4 absorption_color_steps;
    vec4 camera_local;
    vec4 sun_dir;
    vec4 ray_x;
    vec4 ray_y;
    vec4 ray_z;
} pc;

#include "atmosphere/include/constants.glsl"
#include "atmosphere/include/transmittance_lut.glsl"
#include "atmosphere/include/aerial_lut.glsl"

const float AERIAL_RAYLEIGH_PHASE_SCALE = 3.0 / (16.0 * PI);
const float AERIAL_MIE_PHASE_SCALE = 1.0 / (4.0 * PI);

float aerial_phase_rayleigh(float cosTheta)
{
    return AERIAL_RAYLEIGH_PHASE_SCALE * (1.0 + cosTheta * cosTheta);
}

float aerial_phase_mie_hg(float cosTheta, float g)
{
    float g2 = g * g;
    float d = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return AERIAL_MIE_PHASE_SCALE * (1.0 - g2) / (d * sqrt(d));
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 grid = ivec2(int(AERIAL_LUT_RES));
    if (coord.x >= grid.x || coord.y >= grid.y)
    {
        return;
    }

    float planetRadius = pc.planet_center_radius.w;
    float atmRadius = pc.atmosphere_params.x;
    float Hr = max(pc.atmosphere_params.y, 1.0);
    float Hm = max(pc.atmosphere_params.z, 1.0);
    float mieG = clamp(pc.atmosphere_params.w, -0.99, 0.99);
    vec3 betaR = max(pc.beta_rayleigh.rgb, vec3(0.0));
    vec3 betaM = max(pc.beta_mie.rgb, vec3(0.0));
    vec3 absorptionColor = clamp(pc.absorption_color_steps.rgb, vec3(0.0), vec3(1.0));
    vec3 betaA = absorptionColor * max(pc.beta_mie.w, 0.0);
    int subSteps = clamp(int(round(pc.absorption_color_steps.w)), 1, 8);

    vec3 camLocal = pc.camera_local.xyz;
    vec3 center = pc.planet_center_radius.xyz;
    vec3 sunDir = normalize(pc.sun_dir.xyz);

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(grid);
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 rd = normalize(pc.ray_x.xyz * ndc.x + pc.ray_y.xyz * ndc.y + pc.ray_z.xyz);

    bool paramsValid = (planetRadius > 0.0) && (atmRadius > planetRadius) &&
                       any(greaterThan(betaR + betaM + betaA, vec3(0.0)));

    float tBegin;
    float tSpan;
    bool hasSpan = paramsValid && aerial_lut_span(camLocal, rd, center, planetRadius, atmRadius, tBegin, tSpan);

    vec3 betaRA = betaR + betaA;
    float invHr = 1.0 / Hr;
    float invHm = 1.0 / Hm;
    float planetRadius2 = planetRadius * planetRadius;
    float cosTheta = dot(rd, sunDir);
    float phaseR = aerial_phase_rayleigh(cosTheta);
    float phaseM = aerial_phase_mie_hg(cosTheta, mieG);

    float odR = 0.0;
    float odM = 0.0;
    vec3 scatter = vec3(0.0);
    float tPrev = tBegin;

    for (int slice = 0; slice < int(AERIAL_LUT_SLICES); ++slice)
    {
        if (hasSpan)
        {
            float wSlice = (float(slice) + 0.5) / AERIAL_LUT_SLICES;
            float tSlice = aerial_lut_slice_t(tBegin, tSpan, wSlice);
            float dt = (tSlice - tPrev) / float(subSteps);

            for (int i = 0; i < subSteps; ++i)
            {
                float t = tPrev + (float(i) + 0.5) * dt;
                vec3 p = camLocal + rd * t;
                vec3 radial = p - center;
                float r = length(radial);
                float invR = (r > 0.0) ? (1.0 / r) : 0.0;
                float height = max(r - planetRadius, 0.0);

                float densR = exp(-height * invHr);
                float densM = exp(-height * invHm);
                odR += densR * dt;
                odM += densM * dt;

                vec3 attenCam = exp(-(betaRA * odR + betaM * odM));

                float bSun = dot(radial, sunDir);
                float muS = bSun * invR;
                float d2 = r * r - bSun * bSun;
                bool inShadow = (bSun < 0.0) && (d2 < planetRadius2);
                if (!inShadow)
                {
                    vec2 amSun = sample_transmittance_air_mass(transmittanceLut, r, muS, planetRadius, atmRadius);
                    vec2 odSun = amSun * vec2(Hr, Hm);
                    vec3 attenSun = exp(-(betaRA * odSun.x + betaM * odSun.y));
                    vec3 scatterCoeff = densR * betaR * phaseR + densM * betaM * phaseM;
                    scatter += attenCam * attenSun * scatterCoeff * dt;
                }
            }

            tPrev = tSlice;
        }

        ivec3 dst = ivec3(coord, slice);
        vec2 airMass = min(vec2(odR * invHr, odM * invHm), vec2(TRANSMITTANCE_MAX_AIRMASS));
        imageStore(out_aerial_lut, dst, vec4(scatter, 1.0));
        imageStore(out_aerial_optical_depth_lut, dst, vec4(airMass, 0.0, 0.0));
    }
}
