#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, set = 0, binding = 0) uniform writeonly image2D out_sky_view_lut;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D out_sky_optical_depth_lut;
layout(set = 0, binding = 2) uniform sampler2D transmittanceLut;

layout(push_constant) uniform AtmosphereSkyViewPush
{
    vec4 planet_center_radius;
    vec4 atmosphere_params;
    vec4 beta_rayleigh;
    vec4 beta_mie;
    vec4 absorption_color_steps;
    vec4 camera_local;
    vec4 sun_dir;
} pc;

#include "atmosphere/include/constants.glsl"
#include "atmosphere/include/transmittance_lut.glsl"
#include "atmosphere/include/sky_view_lut.glsl"

const float SKY_VIEW_RAYLEIGH_PHASE_SCALE = 3.0 / (16.0 * PI);
const float SKY_VIEW_MIE_PHASE_SCALE = 1.0 / (4.0 * PI);

float sky_view_phase_rayleigh(float cosTheta)
{
    return SKY_VIEW_RAYLEIGH_PHASE_SCALE * (1.0 + cosTheta * cosTheta);
}

float sky_view_phase_mie_hg(float cosTheta, float g)
{
    float g2 = g * g;
    float d = max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4);
    return SKY_VIEW_MIE_PHASE_SCALE * (1.0 - g2) / (d * sqrt(d));
}

bool sky_view_ray_sphere_intersect(vec3 ro, vec3 rd, vec3 center, float radius, out float t0, out float t1)
{
    vec3 oc = ro - center;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - radius * radius;
    float h = b * b - c;
    if (h < 0.0)
    {
        t0 = 0.0;
        t1 = 0.0;
        return false;
    }
    h = sqrt(h);
    t0 = -b - h;
    t1 = -b + h;
    return true;
}

vec3 integrate_sky_view(vec3 camLocal,
                        vec3 rd,
                        vec3 center,
                        float planetRadius,
                        float atmRadius,
                        float Hr,
                        float Hm,
                        vec3 betaR,
                        vec3 betaM,
                        vec3 betaA,
                        float mieG,
                        vec3 sunDir,
                        int steps,
                        out vec2 airMass)
{
    airMass = vec2(0.0);

    float tAtm0;
    float tAtm1;
    if (!sky_view_ray_sphere_intersect(camLocal, rd, center, atmRadius, tAtm0, tAtm1) || tAtm1 <= 0.0)
    {
        return vec3(0.0);
    }

    float tStart = max(tAtm0, 0.0);
    float tEnd = tAtm1;

    float tPlanet0;
    float tPlanet1;
    if (sky_view_ray_sphere_intersect(camLocal, rd, center, planetRadius, tPlanet0, tPlanet1))
    {
        float tGround = (tPlanet0 > 0.0) ? tPlanet0 : tPlanet1;
        if (tGround > 0.0)
        {
            tEnd = min(tEnd, tGround);
        }
    }

    if (tEnd <= tStart)
    {
        return vec3(0.0);
    }

    steps = max(steps, 1);
    float dt = (tEnd - tStart) / float(steps);
    float invHr = 1.0 / max(Hr, 1.0);
    float invHm = 1.0 / max(Hm, 1.0);
    float odR = 0.0;
    float odM = 0.0;
    vec3 scatter = vec3(0.0);
    vec3 betaRA = betaR + betaA;
    float planetRadius2 = planetRadius * planetRadius;
    float cosTheta = dot(rd, sunDir);
    float phaseR = sky_view_phase_rayleigh(cosTheta);
    float phaseM = sky_view_phase_mie_hg(cosTheta, mieG);

    for (int i = 0; i < steps; ++i)
    {
        float t = tStart + (float(i) + 0.5) * dt;
        vec3 p = camLocal + rd * t;
        vec3 radial = p - center;
        float r = length(radial);
        float invR = (r > 0.0) ? (1.0 / r) : 0.0;
        float height = max(r - planetRadius, 0.0);

        float densR = exp(-height * invHr);
        float densM = exp(-height * invHm);
        odR += densR * dt;
        odM += densM * dt;

        vec3 attenCam = exp(-(betaRA * odR + betaM * odM));

        float bSun = dot(radial, sunDir);
        float muS = bSun * invR;
        float d2 = r * r - bSun * bSun;
        bool inShadow = (bSun < 0.0) && (d2 < planetRadius2);
        if (!inShadow)
        {
            vec2 amSun = sample_transmittance_air_mass(transmittanceLut, r, muS, planetRadius, atmRadius);
            vec2 odSun = amSun * vec2(Hr, Hm);
            vec3 attenSun = exp(-(betaRA * odSun.x + betaM * odSun.y));
            vec3 scatterCoeff = densR * betaR * phaseR + densM * betaM * phaseM;
            scatter += attenCam * attenSun * scatterCoeff * dt;
        }
    }

    airMass = min(vec2(odR / max(Hr, 1.0), odM / max(Hm, 1.0)), vec2(TRANSMITTANCE_MAX_AIRMASS));
    return scatter;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_sky_view_lut);
    if (coord.x >= size.x || coord.y >= size.y)
    {
        return;
    }

    float planetRadius = pc.planet_center_radius.w;
    float atmRadius = pc.atmosphere_params.x;
    float Hr = max(pc.atmosphere_params.y, 1.0);
    float Hm = max(pc.atmosphere_params.z, 1.0);
    float mieG = clamp(pc.atmosphere_params.w, -0.99, 0.99);
    vec3 betaR = max(pc.beta_rayleigh.rgb, vec3(0.0));
    vec3 betaM = max(pc.beta_mie.rgb, vec3(0.0));
    vec3 absorptionColor = clamp(pc.absorption_color_steps.rgb, vec3(0.0), vec3(1.0));
    vec3 betaA = absorptionColor * max(pc.beta_mie.w, 0.0);
    int steps = clamp(int(round(pc.absorption_color_steps.w)), 1, 64);

    if (planetRadius <= 0.0 || atmRadius <= planetRadius || !any(greaterThan(betaR + betaM + betaA, vec3(0.0))))
    {
        imageStore(out_sky_view_lut, coord, vec4(0.0));
        imageStore(out_sky_optical_depth_lut, coord, vec4(0.0));
        return;
    }

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(size);
    vec3 camLocal = pc.camera_local.xyz;
    vec3 center = pc.planet_center_radius.xyz;
    vec3 sunDir = normalize(pc.sun_dir.xyz);
    vec3 rd = sky_view_lut_direction(uv, camLocal, center, planetRadius, sunDir);

    vec2 airMass;
    vec3 scatter = integrate_sky_view(camLocal,
                                      rd,
                                      center,
                                      planetRadius,
                                      atmRadius,
                                      Hr,
                                      Hm,
                                      betaR,
                                      betaM,
                                      betaA,
                                      mieG,
                                      sunDir,
                                      steps,
                                      airMass);

    imageStore(out_sky_view_lut, coord, vec4(scatter, 1.0));
    imageStore(out_sky_optical_depth_lut, coord, vec4(airMass, 0.0, 0.0));
}
