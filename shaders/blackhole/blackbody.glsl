vec4 blackbody_sample(float temperature)
{
    float index = log(clamp(temperature, 1000.0, 40000.0) / 1000.0) * (255.0 / log(40.0));
    int lo = min(int(index), 254);
    return mix(BLACKBODY_LUT[lo], BLACKBODY_LUT[lo + 1], index - float(lo));
}
